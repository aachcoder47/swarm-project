<?xml version="1.0"?>
<!--
  FrontierX Scout — Gazebo / Isaac Sim Plugin Definitions
  =========================================================
  Simulation-specific extensions: sensor plugins, differential
  drive plugin, and material overrides.

  These use the ros_gz_sim (Gazebo Harmonic) plugin format.
  For Isaac Sim, the ROS 2 bridge replaces these plugins;
  this file is kept for Gazebo fallback compatibility.
-->
<robot name="frontierx_scout" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="frontierx_scout_gazebo">

    <!-- ── Chassis Friction ──────────────────────────────── -->
    <gazebo reference="base_link">
      <mu1>0.2</mu1>
      <mu2>0.2</mu2>
      <material>Gazebo/DarkGrey</material>
    </gazebo>

    <!-- ── Wheel Friction ────────────────────────────────── -->
    <gazebo reference="wheel_left_link">
      <mu1>2.0</mu1>
      <mu2>2.0</mu2>
      <kp>1e6</kp>
      <kd>1.0</kd>
      <material>Gazebo/Black</material>
    </gazebo>

    <gazebo reference="wheel_right_link">
      <mu1>2.0</mu1>
      <mu2>2.0</mu2>
      <kp>1e6</kp>
      <kd>1.0</kd>
      <material>Gazebo/Black</material>
    </gazebo>

    <!-- Casters: near-frictionless ball joints -->
    <gazebo reference="caster_front_link">
      <mu1>0.01</mu1>
      <mu2>0.01</mu2>
      <material>Gazebo/Grey</material>
    </gazebo>

    <gazebo reference="caster_rear_link">
      <mu1>0.01</mu1>
      <mu2>0.01</mu2>
      <material>Gazebo/Grey</material>
    </gazebo>

    <!-- ── 2D LiDAR Plugin ───────────────────────────────── -->
    <gazebo reference="laser_frame">
      <sensor type="ray" name="frontierx_lidar">
        <pose>0 0 0 0 0 0</pose>
        <visualize>false</visualize>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.120</min>
            <max>12.000</max>
            <resolution>0.001</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
      </sensor>
    </gazebo>

    <!-- ── RGB Camera Plugin ─────────────────────────────── -->
    <gazebo reference="camera_link">
      <sensor type="camera" name="frontierx_rgb_camera">
        <update_rate>30</update_rate>
        <camera name="frontierx_rgb">
          <horizontal_fov>1.204</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>100.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
      </sensor>
    </gazebo>

    <!-- ── Depth Camera Plugin ───────────────────────────── -->
    <gazebo reference="camera_depth_frame">
      <sensor type="depth" name="frontierx_depth_camera">
        <update_rate>30</update_rate>
        <camera name="frontierx_depth">
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>0.300</near>
            <far>3.000</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.002</stddev>
          </noise>
        </camera>
      </sensor>
    </gazebo>

    <!-- ── IMU Plugin ────────────────────────────────────── -->
    <gazebo reference="imu_link">
      <sensor name="frontierx_imu" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00014</stddev>
                <bias_mean>0.0001</bias_mean>
                <bias_stddev>0.00001</bias_stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00014</stddev>
                <bias_mean>0.0001</bias_mean>
                <bias_stddev>0.00001</bias_stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00014</stddev>
                <bias_mean>0.0001</bias_mean>
                <bias_stddev>0.00001</bias_stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0016</stddev>
                <bias_mean>0.0002</bias_mean>
                <bias_stddev>0.00002</bias_stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0016</stddev>
                <bias_mean>0.0002</bias_mean>
                <bias_stddev>0.00002</bias_stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0016</stddev>
                <bias_mean>0.0002</bias_mean>
                <bias_stddev>0.00002</bias_stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
    </gazebo>

  </xacro:macro>

</robot>
