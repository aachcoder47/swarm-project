<?xml version="1.0"?>
<!--
  FrontierX Scout — Base Chassis Xacro
  ======================================
  Defines the mechanical structure:
    - base_footprint (virtual ground contact frame)
    - base_link      (robot body center, ~100mm above floor)
    - Left drive wheel
    - Right drive wheel
    - Front caster
    - Rear caster

  Coordinate conventions:
    - +X = forward
    - +Y = left
    - +Z = up
    - All dimensions in meters, mass in kg
-->
<robot name="frontierx_scout" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ── Physical Constants ────────────────────────────────── -->
  <xacro:property name="base_length"    value="0.300"/>   <!-- meters, X -->
  <xacro:property name="base_width"     value="0.250"/>   <!-- meters, Y -->
  <xacro:property name="base_height"    value="0.100"/>   <!-- meters, Z -->
  <xacro:property name="base_mass"      value="2.500"/>   <!-- kg -->
  <xacro:property name="base_z_offset"  value="0.100"/>   <!-- base_link above floor -->

  <xacro:property name="wheel_radius"   value="0.050"/>   <!-- meters -->
  <xacro:property name="wheel_width"    value="0.030"/>   <!-- meters -->
  <xacro:property name="wheel_mass"     value="0.200"/>   <!-- kg -->
  <xacro:property name="wheel_sep"      value="0.280"/>   <!-- left-right separation -->
  <xacro:property name="wheel_x_offset" value="0.000"/>   <!-- fore-aft offset from base_link -->

  <xacro:property name="caster_radius"  value="0.025"/>
  <xacro:property name="caster_mass"    value="0.050"/>
  <xacro:property name="caster_x_front" value="0.120"/>   <!-- distance forward from base_link -->
  <xacro:property name="caster_x_rear"  value="-0.120"/>   <!-- distance backward from base_link -->

  <!-- ── Inertia Macros ─────────────────────────────────────── -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${m*(y*y+z*z)/12.0}"
        ixy="0" ixz="0"
        iyy="${m*(x*x+z*z)/12.0}"
        iyz="0"
        izz="${m*(x*x+y*y)/12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${m*(3*r*r+h*h)/12.0}"
        ixy="0" ixz="0"
        iyy="${m*(3*r*r+h*h)/12.0}"
        iyz="0"
        izz="${m*r*r/2.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${2*m*r*r/5.0}"
        ixy="0" ixz="0"
        iyy="${2*m*r*r/5.0}"
        iyz="0"
        izz="${2*m*r*r/5.0}"/>
    </inertial>
  </xacro:macro>

  <!-- ── Wheel Macro ────────────────────────────────────────── -->
  <xacro:macro name="wheel" params="name x_offset y_offset">
    <link name="${name}">
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_material">
          <color rgba="0.15 0.15 0.15 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>

    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x_offset} ${y_offset} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.1" friction="0.5"/>
      <limit effort="10.0" velocity="6.0"/>
    </joint>
  </xacro:macro>

  <!-- ── Caster Macro ───────────────────────────────────────── -->
  <xacro:macro name="caster" params="name x_offset">
    <link name="${name}">
      <xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}"/>
      <visual>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
        <material name="caster_material">
          <color rgba="0.6 0.6 0.6 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
      </collision>
    </link>

    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x_offset} 0 ${-base_z_offset + caster_radius}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <!-- ── Base Macro ─────────────────────────────────────────── -->
  <xacro:macro name="frontierx_scout_base">

    <!-- base_footprint: virtual link at ground contact center -->
    <link name="base_footprint">
      <visual>
        <geometry><box size="0.001 0.001 0.001"/></geometry>
      </visual>
    </link>

    <joint name="base_footprint_joint" type="fixed">
      <parent link="base_footprint"/>
      <child link="base_link"/>
      <origin xyz="0 0 ${base_z_offset}" rpy="0 0 0"/>
    </joint>

    <!-- base_link: main robot body -->
    <link name="base_link">
      <xacro:box_inertia m="${base_mass}"
                         x="${base_length}"
                         y="${base_width}"
                         z="${base_height}"/>
      <visual>
        <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${base_length} ${base_width} ${base_height}"/>
        </geometry>
        <material name="chassis_material">
          <!-- FrontierX dark charcoal with slight blue tint -->
          <color rgba="0.12 0.16 0.22 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${base_length} ${base_width} ${base_height}"/>
        </geometry>
      </collision>
    </link>

    <!-- Sensor mast (visual only, structural) -->
    <link name="sensor_mast">
      <visual>
        <origin xyz="0 0 0.10" rpy="0 0 0"/>
        <geometry>
          <box size="0.020 0.020 0.200"/>
        </geometry>
        <material name="mast_material">
          <color rgba="0.08 0.10 0.14 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0.10" rpy="0 0 0"/>
        <geometry>
          <box size="0.020 0.020 0.200"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.100"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.00005"/>
      </inertial>
    </link>

    <joint name="sensor_mast_joint" type="fixed">
      <parent link="base_link"/>
      <child link="sensor_mast"/>
      <origin xyz="0.0 0.0 ${base_height}" rpy="0 0 0"/>
    </joint>

    <!-- Drive wheels -->
    <xacro:wheel name="wheel_left_link"
                 x_offset="${wheel_x_offset}"
                 y_offset="${wheel_sep/2}"/>

    <xacro:wheel name="wheel_right_link"
                 x_offset="${wheel_x_offset}"
                 y_offset="${-wheel_sep/2}"/>

    <!-- Caster wheels -->
    <xacro:caster name="caster_front_link" x_offset="${caster_x_front}"/>
    <xacro:caster name="caster_rear_link"  x_offset="${caster_x_rear}"/>

  </xacro:macro>

</robot>
