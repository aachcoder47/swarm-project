<?xml version="1.0" ?>
<!--
  FrontierX Warehouse Simulation World (Gazebo Harmonic / Gazebo Sim 8)
  ======================================================================
  A large indoor warehouse scene with:
    - Directional sunlight + point lights
    - Concrete ground + perimeter walls
    - Shelving racks and navigation obstacles
    - Physics tuned for differential-drive UGV at real-time factor ~1.0

  Load with:
    gz sim frontierx_warehouse.sdf
  or via the ROS 2 launch file:
    ros2 launch frontierx_sim gazebo.launch.py world:=frontierx_warehouse
-->
<sdf version="1.9">
  <world name="frontierx_warehouse">

    <!-- ── Physics ────────────────────────────────────────── -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- ── Required plugins ───────────────────────────────── -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>
    <plugin filename=
    "gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system"
            name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <publish_link_pose>true</publish_link_pose>
    </plugin>

    <!-- ── Gravity ────────────────────────────────────────── -->
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>5.5645e-6 2.2875e-5 -4.2731e-5</magnetic_field>
    <atmosphere type="adiabatic"/>

    <!-- ── Scene ─────────────────────────────────────────── -->
    <scene>
      <sky/>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.15 0.15 0.18 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- ── Sun (directional light) ───────────────────────── -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <!-- ── Overhead point lights ─────────────────────────── -->
    <light type="point" name="overhead_light_1">
      <pose>5 5 4 0 0 0</pose>
      <diffuse>1 1 0.95 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>12</range>
        <constant>0.5</constant>
        <linear>0.05</linear>
        <quadratic>0.005</quadratic>
      </attenuation>
    </light>

    <light type="point" name="overhead_light_2">
      <pose>-5 -5 4 0 0 0</pose>
      <diffuse>1 1 0.95 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>12</range>
        <constant>0.5</constant>
        <linear>0.05</linear>
        <quadratic>0.005</quadratic>
      </attenuation>
    </light>

    <!-- ── Ground Plane ───────────────────────────────────── -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── Perimeter Walls ───────────────────────────────── -->
    <!-- North wall -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 20 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>40 0.2 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>40 0.2 3</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- South wall -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -20 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>40 0.2 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>40 0.2 3</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- East wall -->
    <model name="wall_east">
      <static>true</static>
      <pose>20 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 40 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 40 3</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- West wall -->
    <model name="wall_west">
      <static>true</static>
      <pose>-20 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 40 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 40 3</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── Shelving Rack A (left aisle) ─────────────────── -->
    <model name="shelf_a1">
      <static>true</static>
      <pose>-8 5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 3.0 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 3.0 2.0</size></box></geometry>
          <material><ambient>0.4 0.3 0.2 1</ambient><diffuse>0.5 0.4 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="shelf_a2">
      <static>true</static>
      <pose>-8 -5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 3.0 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 3.0 2.0</size></box></geometry>
          <material><ambient>0.4 0.3 0.2 1</ambient><diffuse>0.5 0.4 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── Shelving Rack B (right aisle) ────────────────── -->
    <model name="shelf_b1">
      <static>true</static>
      <pose>8 5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 3.0 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 3.0 2.0</size></box></geometry>
          <material><ambient>0.4 0.3 0.2 1</ambient><diffuse>0.5 0.4 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="shelf_b2">
      <static>true</static>
      <pose>8 -5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 3.0 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 3.0 2.0</size></box></geometry>
          <material><ambient>0.4 0.3 0.2 1</ambient><diffuse>0.5 0.4 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── Navigation obstacle boxes ────────────────────── -->
    <model name="box_obstacle_1">
      <static>true</static>
      <pose>3 3 0.25 0 0 0.4</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.8 0.4 0.1 1</ambient><diffuse>0.9 0.5 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box_obstacle_2">
      <static>true</static>
      <pose>-3 -3 0.25 0 0 0.8</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.8 0.4 0.1 1</ambient><diffuse>0.9 0.5 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box_obstacle_3">
      <static>true</static>
      <pose>5 -8 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 0.6 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.6 0.5</size></box></geometry>
          <material><ambient>0.2 0.6 0.2 1</ambient><diffuse>0.3 0.7 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── DEMO FACTORY: Workbench + Pedestal for Robotic Arm ────── -->
    <model name="workbench">
      <static>true</static>
      <pose>-2 -5 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.8 0.8 0.9</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.8 0.8 0.9</size></box></geometry>
          <material><ambient>0.4 0.3 0.2 1</ambient><diffuse>0.55 0.42 0.28 1</diffuse><specular>0.05 0.04 0.02 1</specular></material>
        </visual>
      </link>
    </model>

    <model name="arm_pedestal">
      <static>true</static>
      <pose>-2 -6 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.28</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.28</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.15 0.15 0.18 1</ambient><diffuse>0.2 0.2 0.22 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── DEMO FACTORY: Main Generator #1 (normal) ──────────── -->
    <model name="gen_01">
      <static>true</static>
      <pose>10 2 0.8 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.4 1.2 1.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.4 1.2 1.6</size></box></geometry>
          <material><ambient>0.75 0.75 0.78 1</ambient><diffuse>0.85 0.85 0.88 1</diffuse></material>
        </visual>
      </link>
      <!-- Control panel on front -->
      <link name="panel">
        <pose relative_to="link">0 0.61 0.2 0 0 0</pose>
        <collision name="c">
          <geometry><box><size>0.3 0.02 0.5</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>0.3 0.02 0.5</size></box></geometry>
          <material><ambient>0.15 0.5 0.15 1</ambient><diffuse>0.2 0.7 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── DEMO FACTORY: Backup Generator #2 (overheating + damaged) ── -->
    <model name="gen_02">
      <static>true</static>
      <pose>10 -2 0.8 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.2 1.1 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.2 1.1 1.5</size></box></geometry>
          <!-- Slight yellow tint + rust tones to indicate aged/damaged -->
          <material><ambient>0.65 0.6 0.45 1</ambient><diffuse>0.75 0.68 0.55 1</diffuse></material>
        </visual>
      </link>
      <link name="panel">
        <pose relative_to="link">0 0.56 0.15 0 0 0</pose>
        <visual name="v">
          <geometry><box><size>0.28 0.02 0.45</size></box></geometry>
          <!-- Red control panel to suggest overheating fault -->
          <material><ambient>0.5 0.12 0.12 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse><emissive>0.3 0.05 0.05 1</emissive></material>
        </visual>
      </link>
      <!-- Visible side crack (dark thin box indented) -->
      <link name="crack">
        <pose relative_to="link">0.9 -0.15 0.5 0 0.2 0</pose>
        <visual name="v">
          <geometry><box><size>0.01 0.4 0.6</size></box></geometry>
          <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── DEMO FACTORY: Damaged Component on Workbench ──────── -->
    <model name="comp_damaged_01">
      <static>false</static>
      <pose>-2 -4.5 0.92 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.18</radius><length>0.55</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.18</radius><length>0.55</length></cylinder></geometry>
          <material><ambient>0.4 0.18 0.08 1</ambient><diffuse>0.55 0.22 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── Charging Dock ─────────────────────────────────────── -->
    <model name="dock_01">
      <static>true</static>
      <pose>-10 0 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 0.9 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.9 0.1</size></box></geometry>
          <material><ambient>0.1 0.35 0.6 1</ambient><diffuse>0.2 0.5 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
