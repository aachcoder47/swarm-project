<?xml version="1.0"?>
<package format="3">
  <name>frontierx_interfaces</name>
  <version>0.1.0</version>
  <description>
    Custom ROS 2 messages, services, and actions for the FrontierX Scout
    autonomous mobile robotics platform.
  </description>

  <maintainer email="robotics@frontierxlabs.com">FrontierX Labs</maintainer>
  <license>Apache-2.0</license>
  <url type="website">https://github.com/frontierx-labs/frontierx-robotics</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>action_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>rosidl_default_generators</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
