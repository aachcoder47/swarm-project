# FrontierX Robotics — Base ROS 2 Dockerfile
# ============================================
# Ubuntu 22.04 + ROS 2 Humble + full navigation + perception stack.
#
# Build:
#   docker build -f docker/Dockerfile.ros2 -t frontierx/ros2-humble:latest .
#
# Based on: osrf/ros:humble-desktop-full

FROM osrf/ros:humble-desktop-full

# ── Build arguments ──────────────────────────────────────────
ARG DEBIAN_FRONTEND=noninteractive
ARG ROS_DISTRO=humble

# ── System dependencies ──────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Build tools
    build-essential \
    cmake \
    git \
    wget \
    curl \
    unzip \
    # Python
    python3-pip \
    python3-dev \
    python3-colcon-common-extensions \
    python3-rosdep \
    python3-vcstool \
    # ROS 2 Nav2 full stack
    ros-${ROS_DISTRO}-navigation2 \
    ros-${ROS_DISTRO}-nav2-bringup \
    ros-${ROS_DISTRO}-nav2-msgs \
    # SLAM
    ros-${ROS_DISTRO}-slam-toolbox \
    # Localization
    ros-${ROS_DISTRO}-robot-localization \
    # Teleoperation
    ros-${ROS_DISTRO}-teleop-twist-keyboard \
    ros-${ROS_DISTRO}-teleop-twist-joy \
    # Robot state
    ros-${ROS_DISTRO}-robot-state-publisher \
    ros-${ROS_DISTRO}-joint-state-publisher \
    ros-${ROS_DISTRO}-joint-state-publisher-gui \
    ros-${ROS_DISTRO}-xacro \
    # ros2_control
    ros-${ROS_DISTRO}-ros2-control \
    ros-${ROS_DISTRO}-ros2-controllers \
    ros-${ROS_DISTRO}-diff-drive-controller \
    # Visualization
    ros-${ROS_DISTRO}-rviz2 \
    ros-${ROS_DISTRO}-foxglove-bridge \
    # Diagnostics
    ros-${ROS_DISTRO}-diagnostic-updater \
    ros-${ROS_DISTRO}-diagnostic-msgs \
    # TF2
    ros-${ROS_DISTRO}-tf2-tools \
    ros-${ROS_DISTRO}-tf2-geometry-msgs \
    # Map server
    ros-${ROS_DISTRO}-nav2-map-server \
    ros-${ROS_DISTRO}-map-msgs \
    # Twist mux
    ros-${ROS_DISTRO}-twist-mux \
    # Compressed image transport
    ros-${ROS_DISTRO}-image-transport \
    ros-${ROS_DISTRO}-compressed-image-transport \
    ros-${ROS_DISTRO}-cv-bridge \
    # Depth image processing
    ros-${ROS_DISTRO}-depth-image-proc \
    ros-${ROS_DISTRO}-pcl-ros \
    ros-${ROS_DISTRO}-pcl-conversions \
    # Behavior trees
    ros-${ROS_DISTRO}-behaviortree-cpp-v3 \
    # Testing
    ros-${ROS_DISTRO}-launch-testing-ament-cmake \
    # Utilities
    tmux \
    htop \
    net-tools \
    iputils-ping \
    && rm -rf /var/lib/apt/lists/*

# ── Python dependencies ──────────────────────────────────────
COPY docker/requirements.txt /tmp/requirements.txt
RUN pip3 install --no-cache-dir -r /tmp/requirements.txt

# ── Workspace setup ──────────────────────────────────────────
RUN mkdir -p /opt/ros_ws/src
WORKDIR /opt/ros_ws

# ── FrontierX config directories ─────────────────────────────
RUN mkdir -p \
    /opt/frontierx/models \
    /opt/frontierx/maps \
    /opt/frontierx/world_model \
    /opt/frontierx/config \
    /opt/frontierx/logs

# ── ROS 2 environment ────────────────────────────────────────
ENV PATH="/opt/ros/humble/bin:${PATH}"
ENV PYTHONPATH="/opt/ros/humble/lib/python3.10/site-packages:${PYTHONPATH}"
ENV LD_LIBRARY_PATH="/opt/ros/humble/lib:${LD_LIBRARY_PATH}"
ENV AMENT_PREFIX_PATH="/opt/ros/humble"

RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> /root/.bashrc
RUN echo "source /opt/ros_ws/install/setup.bash 2>/dev/null || true" >> /root/.bashrc
RUN echo "export ROS_DOMAIN_ID=42" >> /root/.bashrc
RUN echo "export RMW_IMPLEMENTATION=rmw_fastrtps_cpp" >> /root/.bashrc

# ── Entrypoint ───────────────────────────────────────────────
COPY docker/ros2_entrypoint.sh /ros2_entrypoint.sh
RUN chmod +x /ros2_entrypoint.sh
ENTRYPOINT ["/ros2_entrypoint.sh"]
CMD ["bash"]
