# Docker environment template
# Copy to docker/.env and fill in your values

# ── ROS 2 ────────────────────────────────────────────────────
ROS_DOMAIN_ID=42

# ── GPU ──────────────────────────────────────────────────────
NVIDIA_VISIBLE_DEVICES=all

# ── LLM ──────────────────────────────────────────────────────
LLM_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://ollama:11434

# ── Paths ────────────────────────────────────────────────────
FRONTIERX_MAPS_PATH=./volumes/maps
FRONTIERX_WORLD_MODEL_PATH=./volumes/world_model
FRONTIERX_MODELS_PATH=./volumes/models

# ── Simulation ───────────────────────────────────────────────
# Set to true when running with Isaac Sim
USE_SIM_TIME=true
ISAAC_SIM_HOST=localhost
ISAAC_SIM_PORT=11111
