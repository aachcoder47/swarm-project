# FrontierX Secrets Template
# Copy this file to docker/.secrets and do NOT commit it to version control.
# Reference these files in docker-compose.override.prod.yml using Docker Secrets.

# ── LLM API Keys ──────────────────────────────────────────────
# OpenAI API Key (if using GPT-4 / OpenAI endpoints)
OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Anthropic API Key (if using Claude endpoints)
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Monitoring Credentials ────────────────────────────────────
# Grafana Admin Password
GRAFANA_PASSWORD=prod-secure-password-change-me

# ── Registry & Deployment Credentials ──────────────────────────
# GitHub Container Registry (GHCR) Token
GHCR_PAT_TOKEN=ghp_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
